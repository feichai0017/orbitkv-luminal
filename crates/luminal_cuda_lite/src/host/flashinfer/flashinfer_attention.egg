; FlashInfer batch decode attention rewrite rule.
;
; Matches the paged attention pattern for ANY model with GQA:
;   Gather(K_cache) → GQA broadcast → Q*K^T matmul → scale → add mask → softmax → attn*V matmul
;   Gather(V_cache) → GQA broadcast ──────────────────────────────────────────→ attn*V matmul
;
; Structural anchors (prevent false matches on MLP/other ops):
;   - Gather ops from 2D cache pools (MLP never uses Gather)
;   - K and V cache gathers use the same flat gather index
;   - GQA broadcast via Mul(gathered, Constant(1.0)) with all-zero strides
;   - Scale Mul(QK, constant) connecting QK scores to mask Add
;   - Mask Add with zero-stride broadcast in first dim (nheads broadcast)
;   - Data flow: two sequential matmul+reduce pairs connected through softmax
;
; The egglog rule captures the mask as a proof-only 5th structural input.
; During extract(), Rust drops that runtime dependency and recovers the compact
; gather_idx input from the lowered flat gather index.
;
; Shape dimensions are egglog variables, not pinned constants.
; Dynamic dims "s" (batch/seq) and "c" (context) stay pinned as MVar.

(relation flashinfer_cache_pair (IR IR))

; Functional PT2 caches can independently lower the K and V row-index
; expansion even when both originate from the same compact slot tensor. Keep
; that semantic provenance as a staged fact instead of requiring the expanded
; `slots * row_width + arange(row_width)` expressions to remain one e-class
; after elementwise fusion.
(relation fi_compact_row_ids (IR))
(relation fi_row_index_base (IR IR))
(relation fi_flat_row_index (IR IR))
(relation fi_same_row_indices (IR IR))

(rule
    ((= ?ids (Input ?node ?label (Int))))
    ((fi_compact_row_ids ?ids))
    :ruleset matmul_backend
    :name "FlashInfer compact row ids input"
)
(rule
    ((= ?ids (Op (Cast ?n (Int)) (ICons ?source (INil)))))
    ((fi_compact_row_ids ?ids))
    :ruleset matmul_backend
    :name "FlashInfer compact row ids cast"
)
(rule
    (
        (= ?ids (Op (Add ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?a (ICons ?b (INil)))))
        (fi_compact_row_ids ?a)
        (fi_compact_row_ids ?b)
    )
    ((fi_compact_row_ids ?ids))
    :ruleset matmul_backend
    :name "FlashInfer compact row ids functional add"
)

(rule
    (
        (= ?base (Op (Mul ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?ids (ICons ?row_width (INil)))))
        (fi_compact_row_ids ?ids)
    )
    ((fi_row_index_base ?base ?ids))
    :ruleset matmul_backend
    :name "FlashInfer row index base lhs"
)
(rule
    (
        (= ?base (Op (Mul ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?row_width (ICons ?ids (INil)))))
        (fi_compact_row_ids ?ids)
    )
    ((fi_row_index_base ?base ?ids))
    :ruleset matmul_backend
    :name "FlashInfer row index base rhs"
)
(rule
    (
        (= ?flat (Op (Add ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?base (ICons ?columns (INil)))))
        (fi_row_index_base ?base ?ids)
    )
    ((fi_flat_row_index ?flat ?ids))
    :ruleset matmul_backend
    :name "FlashInfer flat row index lhs"
)
(rule
    (
        (= ?flat (Op (Add ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?columns (ICons ?base (INil)))))
        (fi_row_index_base ?base ?ids)
    )
    ((fi_flat_row_index ?flat ?ids))
    :ruleset matmul_backend
    :name "FlashInfer flat row index rhs"
)
(rule
    (
        (fi_flat_row_index ?k_flat ?ids)
        (fi_flat_row_index ?v_flat ?ids)
    )
    ((fi_same_row_indices ?k_flat ?v_flat))
    :ruleset matmul_backend
    :name "FlashInfer shared compact row indices"
)

; Head dims the JIT-compiled FlashInfer kernels support (jit.rs asserts the
; same set). Rules must not capture islands for other dims (e.g. gemma-4's
; 512-dim full-attention layers stay on the HLIR chain).
(relation flashinfer_head_dim_ok (Expression))
(flashinfer_head_dim_ok (MNum 64))
(flashinfer_head_dim_ok (MNum 128))
(flashinfer_head_dim_ok (MNum 256))
; 512 is 16-bit only (the f32 kernel instantiation is gated out of the
; wrapper at HEAD_DIM > 256) — used by rules that pin a 16-bit dtype.
(relation flashinfer_head_dim_ok_16bit (Expression))
(flashinfer_head_dim_ok_16bit (MNum 64))
(flashinfer_head_dim_ok_16bit (MNum 128))
(flashinfer_head_dim_ok_16bit (MNum 256))
(flashinfer_head_dim_ok_16bit (MNum 512))

; Mask-chain facts staged for the attention island rules. Every island rule
; anchors at one of these tiny relations instead of inlining its mask atoms.
; Direct producers run in kernel_fuse_late_pre; dependent facts advance across
; the repeated kernel_fuse_late passes before islands consume them in
; kernel_fuse_late2. This keeps joins narrow on rolled multi-layer bodies.
(relation fi_triu_mask (IR IR))
(relation fi_window_term (IR IR f64))
(relation fi_scaled_offset_mask (IR))
(relation fi_direct_causal_mask (IR IR))
(relation fi_causal_columns (IR Expression))
(relation fi_gqa_view (IR IR))
(relation fi_scaled_qk_value (IR IR f64))
(relation fi_softmax_value (IR IR))
(relation fi_hf_blocked_f32 (IR IR))
(relation fi_hf_allowed_f32 (IR IR))
(relation fi_hf_mask_delta (IR IR))

; A constant-valued eclass regardless of dtype: either a plain HLIR Constant
; (f32 graphs) or a folded dtype-typed KernelConstant (the frontend emits
; `constant(v).cast(dt)` for non-f32 scalars, and the kernel_lower fold rule
; unions a KernelConstant into the Cast's eclass).
(relation const_like (IR f64))
(rule ((= ?e (Op (Constant ?v) (INil))))
    ((const_like ?e ?v))
    :ruleset matmul_backend
    :name "FlashInfer const-like hlir"
)
(rule ((= ?e (Op (KernelConstant ?v ?cdt) (INil))))
    ((const_like ?e ?v))
    :ruleset matmul_backend
    :name "FlashInfer const-like kernel"
)

; Column positions appear either as a bare arange or, in HF dynamic-cache
; exports, as arange plus a zero-length/start iota introduced by SymInt
; canonicalization. Stage both spellings into one small fact.
(rule
    ((= ?columns (Op (Iota (MIter) ?context) (INil))))
    ((fi_causal_columns ?columns ?context))
    :ruleset matmul_backend
    :name "FlashInfer causal columns iota"
)
(rule
    (
        (= ?columns (Op (Add
            (ECons ?context (ENil))
            (ECons (MIter) (ENil))
            (ECons (MNum 0) (ENil))
            (ECons (MIter) (ENil)))
            (ICons ?col_iota (ICons ?col_zero (INil)))))
        (= ?col_iota (Op (Iota (MIter) ?context) (INil)))
        (= ?col_zero (Op (Iota (MNum 0) (MNum 1)) (INil)))
    )
    ((fi_causal_columns ?columns ?context))
    :ruleset matmul_backend
    :name "FlashInfer causal columns functional add"
)

; View materialization in PT2 is commonly represented as adding a typed zero.
; Keep the underlying gathered cache tensor recoverable through any number of
; those view-only nodes. The older frontend spelling uses multiplication by a
; typed one and is staged into the same relation.
(rule
    (
        (= ?view (Op (Add ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?source (ICons ?zero (INil)))))
        (const_like ?zero 0.0)
    )
    ((fi_gqa_view ?view ?source))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer GQA zero-add view"
)
(rule
    (
        (= ?view (Op (Mul ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?source (ICons ?one (INil)))))
        (const_like ?one 1.0)
    )
    ((fi_gqa_view ?view ?source))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer GQA one-mul view"
)
(rule
    (
        (fi_gqa_view ?outer ?middle)
        (fi_gqa_view ?middle ?source)
    )
    ((fi_gqa_view ?outer ?source))
    :ruleset kernel_fuse_late
    :name "FlashInfer GQA view transitive"
)

; HF computes QK and the scale in model dtype, then casts the scaled scores to
; F32 for masking/softmax. Other frontends already present the scaled value in
; F32. Preserve both spellings behind one connected fact.
(rule
    (
        (= ?scaled (Op (Mul ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?qk (ICons ?scale (INil)))))
        (const_like ?scale ?scale_val)
    )
    ((fi_scaled_qk_value ?scaled ?qk ?scale_val))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer scaled QK direct"
)
(rule
    (
        (= ?scaled_f32 (Op (Cast ?cast_size (F32)) (ICons ?scaled (INil))))
        (fi_scaled_qk_value ?scaled ?qk ?scale_val)
    )
    ((fi_scaled_qk_value ?scaled_f32 ?qk ?scale_val))
    :ruleset kernel_fuse_late
    :name "FlashInfer scaled QK F32 cast"
)

; The F32 softmax result is cast back to model dtype before the V matmul in
; real f16/bf16 HF graphs. Stage the cast while retaining the raw softmax node
; needed to prove the complete normalization chain.
(rule
    (
        (= ?soft (Op (Mul ?shape ?a_strides ?b_strides ?out_strides)
            (ICons ?exp (ICons ?recip (INil)))))
        (= ?recip (Op (Recip ?recip_shape ?recip_in ?recip_out)
            (ICons ?sum (INil))))
        (= ?sum (Op (Sum ?sum_shape ?sum_dim ?sum_in ?sum_iter ?sum_out)
            (ICons ?exp (INil))))
    )
    ((fi_softmax_value ?soft ?soft))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer softmax value direct"
)
(rule
    (
        (= ?cast_soft (Op (Cast ?cast_size ?cast_dt) (ICons ?soft (INil))))
        (fi_softmax_value ?soft ?raw_soft)
    )
    ((fi_softmax_value ?cast_soft ?raw_soft))
    :ruleset kernel_fuse_late
    :name "FlashInfer softmax value cast"
)

; Dtypes with a tensor-core prefill runtime (16-bit only).
(relation flashinfer_prefill_dt (DType))
(flashinfer_prefill_dt (F16))
(flashinfer_prefill_dt (Bf16))


; K and V cache sources must come from the same cache-update provenance.
; This prevents a rolled loop-body K cache from pairing with the one remaining
; unrolled V cache outside the loop, which is shape-compatible but not the
; same attention instance.
(rule
    (
        (= ?k_cache (Op (Scatter ?k_ds ?k_dst ?k_is ?k_istr ?k_ss)
            (ICons ?k_dest (ICons ?scatter_idx (ICons ?k_src (INil))))))
        (= ?v_cache (Op (Scatter ?v_ds ?v_dst ?v_is ?v_istr ?v_ss)
            (ICons ?v_dest (ICons ?scatter_idx (ICons ?v_src (INil))))))
        (= ?k_dest (Input ?k_node ?k_label ?k_dt))
        (= ?v_dest (Input ?v_node ?v_label ?v_dt))
    )
    ((flashinfer_cache_pair ?k_cache ?v_cache))
    :ruleset matmul_backend
    :name "FlashInfer raw cache pair"
)

(rule
    (
        (= ?k_cache (Op (Scatter ?k_ds ?k_dst ?k_is ?k_istr ?k_ss)
            (ICons ?k_dest (ICons ?scatter_idx (ICons ?k_src (INil))))))
        (= ?v_cache (Op (Scatter ?v_ds ?v_dst ?v_is ?v_istr ?v_ss)
            (ICons ?v_dest (ICons ?scatter_idx (ICons ?v_src (INil))))))
        (= ?k_dest (Op (LoopInput ?loop_id ?k_stream ?k_dt) ?k_loop_inputs))
        (= ?v_dest (Op (LoopInput ?loop_id ?v_stream ?v_dt) ?v_loop_inputs))
    )
    ((flashinfer_cache_pair ?k_cache ?v_cache))
    :ruleset matmul_backend
    :name "FlashInfer rolled cache pair"
)

(rule
    (
        ; ── Second matmul: Mul(softmax_out, V_gqa) ──
        ; Shape: (nheads, s, hdim, c) — 4D
        ; softmax internals connect the mask chain to the second matmul —
        ; without this the two halves join as a cross-product across the
        ; distinct layer instances of rolled multi-layer bodies.
        (= ?smax (Op (Max ?smax_shape ?context ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape ?context ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons ?sequence (ECons ?hdim (ECons ?context (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))

        ; ── Second matmul: Sum (reduction over c) → output ──
        ; Shape: (nheads, s, hdim) — reduces c
        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons ?sequence (ECons ?hdim2 (ENil))))
            ?context
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        ; ── V GQA broadcast: Mul(V_gathered, 1.0) with zero-stride constant ──
        ; Shape: (nheads, c, hdim) — 3D
        (const_like ?v_gqa_const 1.000000)
        (= ?v_gqa (Op (Mul
            (ECons ?nheads3 (ECons (MVar "c") (ECons ?hdim3 (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))

        ; ── V Gather: rows from V_cache (2D) ──
        ; Shape: (c, kvdim), Source: (num_slots, kvdim)
        (= ?v_gathered (Op (Gather
            (ECons ?context (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        ; ── First matmul: Mul(Q, K_gqa) ──
        ; Shape: (nheads, s, c, hdim) — 4D
        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons ?sequence (ECons ?context (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))

        ; ── First matmul: Sum (reduction over hdim) → QK scores ──
        ; Shape: (nheads, s, c) — reduces hdim
        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons ?sequence (ECons ?context (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))

        ; ── Mask Add: Add(scaled_QK, mask) ──
        ; Shape: (nheads, s, c) — 3D
        ; Mask is broadcast from (s, c) via zero-stride in first dim (nheads).
        (= ?masked (Op (Add
            (ECons ?nheads8 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?mask_add_a_strides
            (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        ; The mask-add's first operand is the QK score scaled by a broadcast
        ; constant (1/sqrt(head_dim) — the frontend lowers `scores / s` to
        ; `Mul(scores, const(1/s))`). This atom CONNECTS the Q/K/QK component
        ; to the mask/softmax/output component; without it the premise graph
        ; has two disconnected halves whose join cross-products across the
        ; distinct layer instances of rolled multi-layer bodies (the gemma
        ; 530GB egglog OOM), and Q could pair with another instance's mask.
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?sq_scale_val)

        ; FlashInfer needs qo_indptr/kv_indptr to be recoverable from the mask
        ; expression. Do not match examples that pass a precomputed mask Input.
        ; Mask spelling staged as a fact — see "FlashInfer scaled-offset mask
        ; fact".
        (fi_scaled_offset_mask ?mask)

        ; ── K GQA broadcast: Mul(K_gathered, 1.0) with zero-stride constant ──
        ; Shape: (nheads, hdim, c) — 3D
        (const_like ?k_gqa_const 1.000000)
        (= ?k_gqa (Op (Mul
            (ECons ?nheads6 (ECons ?hdim6 (ECons (MVar "c") (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))

        ; ── K Gather: rows from K_cache (2D) ──
        ; Shape: (c, kvdim), Source: (num_slots, kvdim)
        (= ?k_gathered (Op (Gather
            (ECons ?context (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        ; ── Dtype consistency ──
        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) ?sequence ?context ?dt ?sq_scale_val -1.0)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer batch decode attention"
)

(rule
    (
        ; Direct causal mask spelling:
        ;   (q_pos[:, None] < arange(c)[None, :]).cast(F32) * -1e10
        ; This proves each row blocks a suffix and leaves a valid prefix.
        ;
        ; This spelling currently lowers to the fp32 batch-decode runtime path,
        ; not prefill. It is only valid when the active dynamic-dim bucket proves
        ; s == 1.
        (= ?s_lower (lower (MVar "s")))
        (= ?s_upper (upper (MVar "s")))
        (> ?s_lower 0)
        (< ?s_upper 2)

        ; softmax internals connect the mask chain to the second matmul —
        ; without this the two halves join as a cross-product across the
        ; distinct layer instances of rolled multi-layer bodies.
        (= ?smax (Op (Max ?smax_shape (MVar "c") ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape (MVar "c") ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons (MVar "s") (ECons ?hdim (ECons (MVar "c") (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))

        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons (MVar "s") (ECons ?hdim2 (ENil))))
            (MVar "c")
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        (const_like ?v_gqa_const 1.000000)
        (= ?v_gqa (Op (Mul
            (ECons ?nheads3 (ECons (MVar "c") (ECons ?hdim3 (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))

        (= ?v_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons ?sequence (ECons ?context (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))

        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons ?sequence (ECons ?context (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))

        (= ?masked (Op (Add
            (ECons ?nheads8 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?mask_add_a_strides
            (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        ; The mask-add's first operand is the QK score scaled by a broadcast
        ; constant (1/sqrt(head_dim) — the frontend lowers `scores / s` to
        ; `Mul(scores, const(1/s))`). This atom CONNECTS the Q/K/QK component
        ; to the mask/softmax/output component; without it the premise graph
        ; has two disconnected halves whose join cross-products across the
        ; distinct layer instances of rolled multi-layer bodies (the gemma
        ; 530GB egglog OOM), and Q could pair with another instance's mask.
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?sq_scale_val)

        ; Mask spelling staged as a fact — see "FlashInfer direct causal mask
        ; fact".
        (fi_direct_causal_mask ?mask ?q_pos)

        (const_like ?k_gqa_const 1.000000)
        (= ?k_gqa (Op (Mul
            (ECons ?nheads6 (ECons ?hdim6 (ECons (MVar "c") (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))

        (= ?k_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) (MVar "s") (MVar "c") ?dt ?sq_scale_val -1.0)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer direct causal attention"
)

(rule
    (
        ; Same attention skeleton as above, but accept a causal mask produced
        ; by gathering rows from a square upper-triangular blocked mask:
        ;   triu(c, 1).cast(F32) * -1e10
        ;   gather(q_pos * c + arange(c))
        ; This proves each query row exposes only a prefix of the gathered KV
        ; sequence. Runtime derives decode indptrs from the mask values.
        ;
        ; Like the direct causal spelling, this is decode-only until the fp32
        ; prefill runtime exists. The active bucket must prove s == 1.
        (= ?s_lower (lower (MVar "s")))
        (= ?s_upper (upper (MVar "s")))
        (> ?s_lower 0)
        (< ?s_upper 2)

        ; softmax internals connect the mask chain to the second matmul —
        ; without this the two halves join as a cross-product across the
        ; distinct layer instances of rolled multi-layer bodies.
        (= ?smax (Op (Max ?smax_shape (MVar "c") ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape (MVar "c") ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons (MVar "s") (ECons ?hdim (ECons (MVar "c") (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))

        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons (MVar "s") (ECons ?hdim2 (ENil))))
            (MVar "c")
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        (const_like ?v_gqa_const 1.000000)
        (= ?v_gqa (Op (Mul
            (ECons ?nheads3 (ECons (MVar "c") (ECons ?hdim3 (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))

        (= ?v_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons (MVar "s") (ECons (MVar "c") (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))

        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))

        (= ?masked (Op (Add
            (ECons ?nheads8 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?mask_add_a_strides
            (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        ; The mask-add's first operand is the QK score scaled by a broadcast
        ; constant (1/sqrt(head_dim) — the frontend lowers `scores / s` to
        ; `Mul(scores, const(1/s))`). This atom CONNECTS the Q/K/QK component
        ; to the mask/softmax/output component; without it the premise graph
        ; has two disconnected halves whose join cross-products across the
        ; distinct layer instances of rolled multi-layer bodies (the gemma
        ; 530GB egglog OOM), and Q could pair with another instance's mask.
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?sq_scale_val)

        ; Mask indices are row-aligned triangular-mask rows plus arange(c).
        ; Triu-gather causal mask, staged as a fact in kernel_fuse_late_pre
        ; (see "FlashInfer triu mask fact"). Anchoring this rule at the
        ; tiny fact relation instead of inlining the ~20 mask atoms keeps
        ; the join narrow on rolled bodies with many distinct attention
        ; instances (gemma: 35+ min / OOM as a single inlined join).
        (fi_triu_mask ?mask ?q_pos)

        (const_like ?k_gqa_const 1.000000)
        (= ?k_gqa (Op (Mul
            (ECons ?nheads6 (ECons ?hdim6 (ECons (MVar "c") (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))

        (= ?k_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) (MVar "s") (MVar "c") ?dt ?sq_scale_val -1.0)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer causal triu-gather attention"
)

(rule
    (
        ; Same attention skeleton as above, but accept a causal mask produced
        ; by gathering rows from a square upper-triangular blocked mask:
        ;   triu(c, 1).cast(F32) * -1e10
        ;   gather(q_pos * c + arange(c))
        ; This proves each query row exposes only a prefix of the gathered KV
        ; sequence. 16-bit variant: matches prefill buckets too, since the
        ; tensor-core prefill runtime exists for f16/bf16.
        ; No s==1 guard: 16-bit dtypes have a tensor-core prefill runtime, so
        ; this matches every bucket. The runtime picks decode vs prefill from
        ; total_q_tokens at execute time.
        (flashinfer_prefill_dt ?dt)

        ; softmax internals connect the mask chain to the second matmul —
        ; without this the two halves join as a cross-product across the
        ; distinct layer instances of rolled multi-layer bodies.
        (= ?smax (Op (Max ?smax_shape ?context ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape ?context ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))
        (fi_softmax_value ?soft_for_v ?soft)

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons ?sequence (ECons ?hdim (ECons ?context (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft_for_v (ICons ?v_gqa (INil)))))

        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons ?sequence (ECons ?hdim2 (ENil))))
            ?context
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        (fi_gqa_view ?v_gqa ?v_gathered)

        (= ?v_gathered (Op (Gather
            (ECons ?context (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons ?sequence (ECons ?context (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))

        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons ?sequence (ECons ?context (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))

        (= ?masked (Op (Add
            ?masked_shape
            ?mask_add_a_strides
            ?mask_add_b_strides
            ?mask_add_out_strides)
            (ICons ?scaled_for_mask (ICons ?mask (INil)))))
        ; The mask-add's first operand is the QK score scaled by a broadcast
        ; constant (1/sqrt(head_dim) — the frontend lowers `scores / s` to
        ; `Mul(scores, const(1/s))`). This atom CONNECTS the Q/K/QK component
        ; to the mask/softmax/output component; without it the premise graph
        ; has two disconnected halves whose join cross-products across the
        ; distinct layer instances of rolled multi-layer bodies (the gemma
        ; 530GB egglog OOM), and Q could pair with another instance's mask.
        (fi_scaled_qk_value ?scaled_for_mask ?qk ?sq_scale_val)

        ; Mask indices are row-aligned triangular-mask rows plus arange(c).
        ; Triu-gather causal mask, staged as a fact in kernel_fuse_late_pre
        ; (see "FlashInfer triu mask fact"). Anchoring this rule at the
        ; tiny fact relation instead of inlining the ~20 mask atoms keeps
        ; the join narrow on rolled bodies with many distinct attention
        ; instances (gemma: 35+ min / OOM as a single inlined join).
        (fi_triu_mask ?mask ?q_pos)

        (fi_gqa_view ?k_gqa ?k_gathered)

        (= ?k_gathered (Op (Gather
            (ECons ?context (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) ?sequence ?context ?dt ?sq_scale_val -1.0)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer causal triu-gather attention 16-bit prefill"
)

; ── Gemma-4 variants ──
;
; Scale-free scores (attention scaling 1.0) and, on sliding layers, a window
; term added to the causal mask. The mask chains are staged into relation
; facts (anchored at their -1e10 constants), and the attention skeleton
; matches the softmax internals so the whole rule is ONE connected chain —
; an unconnected ?masked/?soft pair cross-products across the distinct layer
; instances of a rolled multi-layer body and never finishes joining.

(rule
    (
        (= ?cmask (Op (Gather
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?mask_idx_strides
            (ECons (MVar "c") (ECons (MVar "c") (ENil)))
            ?mask_src_strides)
            (ICons ?mask_indices (ICons ?scaled_blocked (INil)))))
        (= ?mask_indices (Op (Add
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?row_idx_strides
            ?col_idx_strides
            ?mask_idx_out_strides)
            (ICons ?row_offsets (ICons ?col_offsets (INil)))))
        (= ?col_offsets (Op (Iota (MIter) (MVar "c")) (INil)))
        (= ?row_offsets (Op (Mul
            (ECons (MVar "s") (ENil))
            ?q_pos_strides
            ?ctx_scalar_strides
            ?row_offsets_out_strides)
            (ICons ?q_pos (ICons ?ctx_scalar (INil)))))
        (= ?ctx_scalar (Op (Iota (MVar "c") (MNum 1)) (INil)))

        (= ?scaled_blocked (Op (Mul
            (ECons (MVar "c") (ECons (MVar "c") (ENil)))
            ?blocked_strides
            ?neg_scale_strides
            ?scaled_blocked_strides)
            (ICons ?blocked_f32 (ICons ?neg_mask_scale (INil)))))
        (const_like ?neg_mask_scale ?neg_mask_scale_val)
        (< ?neg_mask_scale_val -9999999999.0)
        (> ?neg_mask_scale_val -10000000001.0)
        (= ?blocked_f32 (Op (Cast ?blocked_cast_size ?blocked_cast_dt)
            (ICons ?blocked_bool (INil))))
        (= ?blocked_bool (Op (LessThan
            (ECons (MVar "c") (ECons (MVar "c") (ENil)))
            ?tri_row_strides
            ?tri_col_strides
            ?blocked_out_strides)
            (ICons ?tri_iota_f32 (ICons ?tri_iota_minus_zero (INil)))))
        (= ?tri_iota_minus_zero (Op (Add
            (ECons (MVar "c") (ECons (MVar "c") (ENil)))
            ?tri_minus_zero_a_strides
            ?tri_minus_zero_b_strides
            ?tri_minus_zero_out_strides)
            (ICons ?tri_iota_f32 (ICons ?zero_offset (INil)))))
        (= ?zero_offset (Op (Mul
            (ECons (MVar "c") (ECons (MVar "c") (ENil)))
            ?zero_offset_a_strides
            ?zero_offset_b_strides
            ?zero_offset_out_strides)
            (ICons ?zero_const (ICons ?neg_one_const (INil)))))
        (= ?zero_const (Op (Constant 0.000000) (INil)))
        (= ?neg_one_const (Op (Constant -1.000000) (INil)))
        (= ?tri_iota_f32 (Op (Cast ?tri_iota_cast_size (F32))
            (ICons ?tri_iota (INil))))
        (= ?tri_iota (Op (Iota (MIter) (MVar "c")) (INil)))
    )
    (
        (fi_triu_mask ?cmask ?q_pos)
    )
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer triu mask fact"
)

(rule
    (
        ; Legacy decode mask spelling: Add(Mul(allowed, 1e10), offset). The
        ; "batch decode attention" island rule anchors at this fact.
        (= ?mask (Op (Add ?inner_mask_shape ?inner_mask_a_strides ?inner_mask_b_strides ?inner_mask_out_strides)
            (ICons ?mask_scaled_allowed (ICons ?mask_offset (INil)))))
        (= ?mask_scaled_allowed (Op (Mul ?allowed_shape ?allowed_strides ?scale_const_strides ?scaled_allowed_strides)
            (ICons ?mask_allowed (ICons ?mask_scale_const (INil)))))
        (const_like ?mask_scale_const ?mask_scale_val)
        (> ?mask_scale_val 9999999999.0)
        (< ?mask_scale_val 10000000001.0)
    )
    (
        (fi_scaled_offset_mask ?mask)
    )
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer scaled-offset mask fact"
)

(rule
    (
        ; Direct causal mask spelling:
        ;   (q_pos[:, None] < arange(c)[None, :]).cast(F32) * -1e10
        ; The "direct causal attention" island rule anchors at this fact.
        (= ?mask (Op (Mul
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?blocked_strides
            ?neg_scale_strides
            ?mask_out_strides)
            (ICons ?blocked_f32 (ICons ?neg_mask_scale (INil)))))
        (const_like ?neg_mask_scale ?neg_mask_scale_val)
        (< ?neg_mask_scale_val -9999999999.0)
        (> ?neg_mask_scale_val -10000000001.0)
        (= ?blocked_f32 (Op (Cast ?blocked_cast_size ?blocked_cast_dt)
            (ICons ?blocked_bool (INil))))
        (= ?blocked_bool (Op (LessThan
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?q_pos_cmp_strides
            ?col_cmp_strides
            ?blocked_out_strides)
            (ICons ?q_pos (ICons ?col_offsets (INil)))))
        (= ?col_offsets (Op (Iota (MIter) (MVar "c")) (INil)))
    )
    (
        (fi_direct_causal_mask ?mask ?q_pos)
    )
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer direct causal mask fact"
)

; Hugging Face's Qwen eager-attention mask lowers `where(allowed, baseline,
; finfo_min)` into arithmetic. Stage the chain in small connected pieces: this
; avoids one expensive join and makes a missing frontend spelling observable.
(rule
    (
        (= ?blocked_f32 (Op (Cast ?blocked_f32_size (F32))
            (ICons ?blocked_bool (INil))))
        (= ?blocked_bool (Op (LessThan
            (ECons (MNum 1) (ECons (MNum 1) (ECons ?sequence (ECons ?context (ENil)))))
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MIter) (ECons (MNum 0) (ENil)))))
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ECons (MIter) (ENil)))))
            ?blocked_out_strides)
            (ICons ?q_pos (ICons ?col_offsets (INil)))))
        (fi_causal_columns ?col_offsets ?context)
    )
    ((fi_hf_blocked_f32 ?blocked_f32 ?q_pos))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer HF blocked positions"
)

(rule
    (
        (= ?allowed_f32 (Op (Cast ?allowed_f32_size (F32))
            (ICons ?allowed_bool (INil))))
        (= ?allowed_bool (Op (Cast ?allowed_bool_size (Bool))
            (ICons ?allowed_numeric (INil))))
        (= ?allowed_numeric (Op (Add ?allowed_shape
            ?negative_blocked_strides ?one_strides ?allowed_numeric_out_strides)
            (ICons ?negative_blocked (ICons ?one (INil)))))
        (const_like ?one 1.0)
        (= ?negative_blocked (Op (Mul ?negative_shape
            ?blocked_f32_strides ?blocked_neg_one_strides ?negative_blocked_out_strides)
            (ICons ?blocked_f32 (ICons ?blocked_neg_one (INil)))))
        (const_like ?blocked_neg_one -1.0)
        (fi_hf_blocked_f32 ?blocked_f32 ?q_pos)
    )
    ((fi_hf_allowed_f32 ?allowed_f32 ?q_pos))
    :ruleset kernel_fuse_late
    :name "FlashInfer HF allowed positions"
)

(rule
    (
        (= ?delta (Op (Add ?delta_shape
            ?baseline_strides ?positive_limit_strides ?delta_out_strides)
            (ICons ?baseline_f32 (ICons ?positive_limit (INil)))))
        (= ?baseline_f32 (Op (Cast (MNum 1) (F32))
            (ICons ?baseline (INil))))
        (= ?positive_limit (Op (Mul ?positive_limit_shape
            ?limit_strides ?limit_neg_one_strides ?positive_limit_out_strides)
            (ICons ?mask_min (ICons ?limit_neg_one (INil)))))
        (const_like ?limit_neg_one -1.0)
        (const_like ?mask_min ?mask_min_val)
        (< ?mask_min_val -1.0e30)
    )
    ((fi_hf_mask_delta ?delta ?mask_min))
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer HF min-fill delta"
)

(rule
    (
        (= ?mask (Op (Add ?mask_shape
            ?mask_min_strides ?selected_strides ?mask_out_strides)
            (ICons ?mask_min (ICons ?selected (INil)))))
        (= ?selected (Op (Mul ?selected_shape
            ?allowed_strides ?delta_strides ?selected_out_strides)
            (ICons ?allowed_f32 (ICons ?delta (INil)))))
        (fi_hf_allowed_f32 ?allowed_f32 ?q_pos)
        (fi_hf_mask_delta ?delta ?mask_min)
    )
    (
        ; `fi_triu_mask` historically means "causal mask with recoverable row
        ; positions", not exclusively a literal Triu op.
        (fi_direct_causal_mask ?mask ?q_pos)
        (fi_triu_mask ?mask ?q_pos)
    )
    :ruleset kernel_fuse_late
    :name "FlashInfer HF min-fill causal mask fact"
)

(rule
    (
        ; window term: (col < q_pos - (W-1)) cast * -1e10; the constant W-1
        ; is FlashInfer's window_left.
        (= ?wterm (Op (Mul
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?wt_a_strides
            ?wt_b_strides
            ?wt_out_strides)
            (ICons ?w_bool_cast (ICons ?w_negbig (INil)))))
        (const_like ?w_negbig ?w_negbig_val)
        (< ?w_negbig_val -9999999999.0)
        (> ?w_negbig_val -10000000001.0)
        (= ?w_bool_cast (Op (Cast ?w_cast_size ?w_cast_dt)
            (ICons ?w_lt (INil))))
        (= ?w_lt (Op (LessThan
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            (ECons (MNum 0) (ECons (MIter) (ENil)))
            (ECons (MIter) (ECons (MNum 0) (ENil)))
            ?w_lt_out_strides)
            (ICons ?w_col_f (ICons ?w_lo (INil)))))
        (= ?w_col_f (Op (Cast ?w_col_cast_size (F32)) (ICons ?w_col_iota (INil))))
        (= ?w_col_iota (Op (Iota (MIter) (MVar "c")) (INil)))
        (= ?w_lo (Op (Add
            (ECons (MVar "s") (ENil))
            ?w_lo_a_strides
            ?w_lo_b_strides
            ?w_lo_out_strides)
            (ICons ?w_qpos_f (ICons ?w_neg (INil)))))
        (= ?w_qpos_f (Op (Cast ?w_qpos_cast_size (F32)) (ICons ?w_qpos (INil))))
        (= ?w_neg (Op (Mul
            (ECons (MVar "s") (ENil))
            (ECons (MNum 0) (ENil))
            (ECons (MNum 0) (ENil))
            ?w_neg_out_strides)
            (ICons ?w_window (ICons ?w_negone (INil)))))
        (= ?w_window (Op (Constant ?window_left) (INil)))
        (= ?w_negone (Op (Constant -1.000000) (INil)))
    )
    (
        (fi_window_term ?wterm ?w_qpos ?window_left)
    )
    :ruleset kernel_fuse_late_pre
    :name "FlashInfer window term fact"
)

(rule
    (
        ; Gemma-4 full attention: scale-free, causal triu-gather mask.
        ; 16-bit only (covers head_dim 512); no s==1 guard — the tensor-core
        ; prefill runtime handles s>1.
        (= ?s_lower (lower (MVar "s")))
        (= ?s_upper (upper (MVar "s")))
        (> ?s_lower 0)
        (< ?s_upper 2)

        (flashinfer_prefill_dt ?dt)
        (fi_triu_mask ?mask ?q_pos)
        ; mask Add → softmax internals → second matmul: one connected chain.
        (= ?masked (Op (Add
            (ECons ?nheads8 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?mask_add_a_strides
            (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?qk (ICons ?mask (INil)))))
        (= ?smax (Op (Max ?smax_shape (MVar "c") ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape (MVar "c") ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons (MVar "s") (ECons ?hdim (ECons (MVar "c") (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))

        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons (MVar "s") (ECons ?hdim2 (ENil))))
            (MVar "c")
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        (const_like ?v_gqa_const 1.000000)
        (= ?v_gqa (Op (Mul
            (ECons ?nheads3 (ECons (MVar "c") (ECons ?hdim3 (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))

        (= ?v_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        ; SCALE-FREE: ?qk (the raw QK Sum) feeds the mask Add directly.
        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))
        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons (MVar "s") (ECons (MVar "c") (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))
        (const_like ?k_gqa_const 1.000000)
        (= ?k_gqa (Op (Mul
            (ECons ?nheads6 (ECons ?hdim6 (ECons (MVar "c") (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))

        (= ?k_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok_16bit ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) (MVar "s") (MVar "c") ?dt 1.0 -1.0)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer gemma scale-free triu-gather attention"
)

(rule
    (
        ; Gemma-4 sliding-window attention: scale-free, causal triu-gather
        ; mask + window term; window_left carried onto the op.
        (= ?s_lower (lower (MVar "s")))
        (= ?s_upper (upper (MVar "s")))
        (> ?s_lower 0)
        (< ?s_upper 2)

        (flashinfer_prefill_dt ?dt)
        (= ?mask (Op (Add
            (ECons (MVar "s") (ECons (MVar "c") (ENil)))
            ?wm_a_strides
            ?wm_b_strides
            ?wm_out_strides)
            (ICons ?cmask (ICons ?wterm (INil)))))
        (fi_triu_mask ?cmask ?q_pos)
        (fi_window_term ?wterm ?q_pos2 ?window_left)
        (= ?q_pos ?q_pos2)
        ; mask Add → softmax internals → second matmul: one connected chain.
        (= ?masked (Op (Add
            (ECons ?nheads8 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?mask_add_a_strides
            (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?qk (ICons ?mask (INil)))))
        (= ?smax (Op (Max ?smax_shape (MVar "c") ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape (MVar "c") ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out) (ICons ?sexpsum (INil))))
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))

        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons (MVar "s") (ECons ?hdim (ECons (MVar "c") (ENil)))))
            ?mul2_a_strides
            ?mul2_b_strides
            ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))

        (= ?output (Op (Sum
            (ECons ?nheads2 (ECons (MVar "s") (ECons ?hdim2 (ENil))))
            (MVar "c")
            ?out_in_strides
            (MIter)
            ?out_out_strides)
            (ICons ?mul2 (INil))))

        (const_like ?v_gqa_const 1.000000)
        (= ?v_gqa (Op (Mul
            (ECons ?nheads3 (ECons (MVar "c") (ECons ?hdim3 (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))

        (= ?v_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?kvdim2 (ENil)))
            ?v_src_strides)
            (ICons ?v_idx (ICons ?v_cache (INil)))))

        ; SCALE-FREE: ?qk (the raw QK Sum) feeds the mask Add directly.
        (= ?qk (Op (Sum
            (ECons ?nheads5 (ECons (MVar "s") (ECons (MVar "c") (ENil))))
            ?hdim5
            ?qk_in_strides
            (MIter)
            ?qk_out_strides)
            (ICons ?mul1 (INil))))
        (= ?mul1 (Op (Mul
            (ECons ?nheads4 (ECons (MVar "s") (ECons (MVar "c") (ECons ?hdim4 (ENil)))))
            ?mul1_a_strides
            ?mul1_b_strides
            ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))
        (const_like ?k_gqa_const 1.000000)
        (= ?k_gqa (Op (Mul
            (ECons ?nheads6 (ECons ?hdim6 (ECons (MVar "c") (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))

        (= ?k_gathered (Op (Gather
            (ECons (MVar "c") (ECons ?kvdim3 (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?kvdim4 (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))

        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
        (fi_same_row_indices ?k_idx ?v_idx)
        (flashinfer_head_dim_ok_16bit ?hdim)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1) (MVar "s") (MVar "c") ?dt 1.0 ?window_left)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2
    :name "FlashInfer gemma sliding triu-gather attention"
)

; A FlashInfer match is a proof that the complete attention decomposition is
; supported by the specialized HostOp: cache provenance, causal-mask spelling,
; dtype, head dimension, GQA layout, and score scaling were all checked by the
; producing rule above. Once that proof exists, retaining the decomposed Sum,
; GenericMatmul, and cuBLASLt spellings in the same IR e-class only turns
; backend selection into a low-probability search mutation. On large rolled
; models that mutation is usually coupled to unrelated invalid choices, so the
; valid FlashInfer implementation may never even be profiled.
;
; Only these concrete compute implementations are replaceable. In particular,
; do not subsume LoopInput / LoopOutput and other structural Op spellings that
; can share an e-class while a rolled model is being represented.
(relation fi_replaceable_attention_kind (OpKind))

(rule
    ((= ?kind (Sum ?shape ?iters ?strides ?iter_stride ?out_strides)))
    ((fi_replaceable_attention_kind ?kind))
    :ruleset kernel_commit_mark
    :name "FlashInfer replaceable Sum kind"
)

; `Sum` is lowered to `KernelSum` before the final FlashInfer rule runs. Both
; spellings can remain in the attention-output e-class, depending on whether
; the output belongs to a rolled loop body or its peeled boundary iteration.
; If KernelSum is not committed away, extraction can independently choose the
; generic reduction for one spelling and FlashInfer for the other, yielding a
; 1/47 split in a 48-layer model.
(rule
    ((= ?kind (KernelSum
        ?shape ?iters ?strides ?iter_stride ?out_strides ?dtype)))
    ((fi_replaceable_attention_kind ?kind))
    :ruleset kernel_commit_mark
    :name "FlashInfer replaceable KernelSum kind"
)

(rule
    ((= ?kind (GenericMatmul
        ?out_shape ?mul_shape ?k ?lhs_strides ?rhs_strides
        ?sum_input_strides ?sum_iter_stride ?out_strides ?dtype)))
    ((fi_replaceable_attention_kind ?kind))
    :ruleset kernel_commit_mark
    :name "FlashInfer replaceable GenericMatmul kind"
)

(rule
    ((= ?kind (cublaslt
        ?m ?n ?k ?a_layout ?b_layout ?a_order ?b_order ?c_order ?d_order
        ?lda ?ldb ?ldc ?ldd ?batch_count ?stride_a ?stride_b ?stride_c ?stride_d
        ?a_dtype ?b_dtype ?c_dtype ?d_dtype ?compute_type ?scale_dtype
        ?alpha ?beta ?epilogue)))
    ((fi_replaceable_attention_kind ?kind))
    :ruleset kernel_commit_mark
    :name "FlashInfer replaceable cuBLASLt kind"
)

(rule
    ((= ?kind (cublaslt_scaled
        ?m ?n ?k ?a_layout ?b_layout ?a_order ?b_order ?c_order ?d_order
        ?lda ?ldb ?ldc ?ldd ?batch_count ?stride_a ?stride_b ?stride_c ?stride_d
        ?a_dtype ?b_dtype ?c_dtype ?d_dtype ?compute_type ?scale_dtype
        ?alpha ?beta ?epilogue)))
    ((fi_replaceable_attention_kind ?kind))
    :ruleset kernel_commit_mark
    :name "FlashInfer replaceable scaled cuBLASLt kind"
)

; A matched FlashInfer op is now committed over only the decomposed compute
; alternatives above. Compiler loop markers remain available to the unroller.
(rule
    (
        (= ?fi (Op
            (FlashInferAttention
                ?nheads ?nkvheads ?hdim ?batch ?sequence ?context ?dt ?scale ?window_left)
            ?fi_inputs))
        (= ?alternative (Op ?alternative_kind ?alternative_inputs))
        (= ?alternative ?fi)
        (fi_replaceable_attention_kind ?alternative_kind)
    )
    (
        (subsume (Op ?alternative_kind ?alternative_inputs))
    )
    :ruleset kernel_commit
    :name "FlashInfer commit proven attention HostOp"
)
