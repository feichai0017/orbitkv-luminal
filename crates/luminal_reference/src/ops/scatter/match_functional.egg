; Layout Tensor Op Scatter Functional — variable arity: init and src
; first (fixed slots), then one coordinate layout tensor per init axis,
; one fresh written output. WELL-FORMEDNESS is a positive premise: the
; coordinates' common shape and src's shape bind to ONE variable, so the
; match waits for the proof (never optimistic). The write gate is the
; usual injectivity of the destination.
(rule
  (
    (= ?out_logical (LogicalScatter ?init_logical ?coordinate_list ?src_logical))
    (= ?init_layout_tensor (LayoutTensorLit ?init_logical ?init_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?init_layout (RightMajorContiguousElementLayoutLit ?init_cshape ?init_cbits))
    (= ?init_cshape (shape-of ?init_logical))
    (= ?init_cbits (bits-of (dtype-of ?init_logical)))
    (= ?src_layout_tensor (LayoutTensorLit ?src_logical ?src_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?src_layout (RightMajorContiguousElementLayoutLit ?src_cshape ?src_cbits))
    (= ?src_cshape (shape-of ?src_logical))
    (= ?src_cbits (bits-of (dtype-of ?src_logical)))
    (coordinate-layout-tensors ?coordinate_list ?coordinate_layout_tensors)
    (= ?src_shape (shape-of ?src_logical))
    (= ?src_shape (coords-common-shape ?coordinate_list))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_cshape ?out_cbits))
    (= ?out_cshape (shape-of ?out_logical))
    (= ?out_cbits (bits-of (dtype-of ?out_logical)))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?init_layout_tensor
          (LayoutTensorCons ?src_layout_tensor ?coordinate_layout_tensors))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpScatterFunctionalGeneric ?init_layout_tensor ?src_layout_tensor ?coordinate_layout_tensors ?out_layout))
  )
)
