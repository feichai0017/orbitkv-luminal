; Layout Tensor Op Mod Generic
(rule
  (
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?in1_layout (RightMajorContiguousElementLayoutLit ?in1_cshape ?in1_cbits))
    (= ?in1_cshape (shape-of ?in1_logical))
    (= ?in1_cbits (bits-of (dtype-of ?in1_logical)))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?in2_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?in2_layout (RightMajorContiguousElementLayoutLit ?in2_cshape ?in2_cbits))
    (= ?in2_cshape (shape-of ?in2_logical))
    (= ?in2_cbits (bits-of (dtype-of ?in2_logical)))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    ; CANONICAL-ONLY: this slot must carry its logical's own right-major
    ; contiguous layout. The kernels fabricate dense right-major strides
    ; in Rust and never read a layout, so before this premise a left-major
    ; operand was accepted and silently mis-indexed.
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_cshape ?out_cbits))
    (= ?out_cshape (shape-of ?out_logical))
    (= ?out_cbits (bits-of (dtype-of ?out_logical)))
    (= ?out_logical (LogicalMod ?in1_logical ?in2_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor
          (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpModFunctionalGeneric ?in1_layout_tensor ?in2_layout_tensor ?out_layout))
  )
)
