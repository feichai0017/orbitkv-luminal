; Layout Tensor Op MatMul Fused Generic — the chain-fusion match.
;
; Recognizes the CANONICAL matmul decomposition
;   out = ReduceSum_k( IndexMapApply(lhs, [i, k]) * IndexMapApply(rhs, [k, j]) )
; over the expanded shape [M, N, K] (K innermost = reduction axis 0; CoordVar
; axes are zero-based from the innermost, so k = axis 0, j = axis 1, i = axis
; 2; each view's entries are listed from its parent's outermost axis inward).
;
; The minted op's INPUT list holds the ORIGINAL lhs/rhs layout tensors and its
; OUTPUT list only the contraction result: the broadcast views and the
; [M, N, K] product appear in neither, so a plan that selects this op never
; demands them — no product buffer ever exists. Soundness does not need
; operand-shape premises: the two view maps are pure coordinate selections,
; so the kernel's reads through lhs/rhs layouts at (i, k) / (k, j) ARE the
; views' elements, and the reduce shape rule already forces out = [M, N].
(rule
  (
    (= ?lhs_layout_tensor (LayoutTensorLit ?lhs_logical ?lhs_layout))
    (= ?rhs_layout_tensor (LayoutTensorLit ?rhs_logical ?rhs_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    (= ?out_logical (LogicalReduceSum ?product_logical 0))
    (= ?product_logical (LogicalMul ?lhs_expanded ?rhs_expanded))
    (= ?lhs_expanded (LogicalIndexMapApply ?lhs_logical ?lhs_map ?expanded_shape))
    (= ?rhs_expanded (LogicalIndexMapApply ?rhs_logical ?rhs_map ?expanded_shape))
    (= ?expanded_shape
       (ShapeLit
         (IntExprCons ?m_dim (IntExprCons ?n_dim (IntExprCons ?k_dim (IntExprNil))))))
    (= ?lhs_map
       (IndexMapLit
         (IntExprCons (CoordVar 2 ?m_dim) (IntExprCons (CoordVar 0 ?k_dim) (IntExprNil)))))
    (= ?rhs_map
       (IndexMapLit
         (IntExprCons (CoordVar 0 ?k_dim) (IntExprCons (CoordVar 1 ?n_dim) (IntExprNil)))))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?lhs_layout_tensor (LayoutTensorCons ?rhs_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))
      )
    )
    (union ?layout_tensor_op
      (LayoutTensorOpMatMulFusedGeneric ?lhs_layout_tensor ?rhs_layout_tensor ?out_layout)
    )
  )
)
