;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Layout indexing trial for the checkpoint 5 egglog preamble.

; Rank-1 concrete shape:
;   shape = [10]
;   element index = CoordVar(shape1, 0)
(let shape1
  (ShapeLit
    (IntExprCons (IntLit 10)
      (IntExprNil))))

(let layout1
  (RightMajorContiguousElementLayoutLit shape1 (bits-of (Int))))

; Scalar shape:
;   shape = []
;   element index = 0
(let shape_scalar
  (ShapeLit (IntExprNil)))

(let layout_scalar
  (RightMajorContiguousElementLayoutLit shape_scalar (bits-of (F32))))

; Rank-3 concrete shape:
;   shape = [30, 20, 10]
;   element index =
;     v2 * 200 + v1 * 10 + v0
;   (all coordinates owned by shape3_concrete)
(let shape3_concrete
  (ShapeLit
    (IntExprCons (IntLit 30)
      (IntExprCons (IntLit 20)
        (IntExprCons (IntLit 10)
          (IntExprNil))))))

(let layout3_concrete
  (RightMajorContiguousElementLayoutLit shape3_concrete (bits-of (F32))))

(let linear3_concrete
  (IntAdd
    (IntMul (CoordVar shape3_concrete 2) (IntLit 200))
    (IntAdd
      (IntMul (CoordVar shape3_concrete 1) (IntLit 10))
      (CoordVar shape3_concrete 0))))

(let right_strides3_concrete
  (IntExprCons (IntLit 200)
    (IntExprCons (IntLit 10)
      (IntExprCons (IntLit 1)
        (IntExprNil)))))

(let layout3_left_concrete
  (LeftMajorContiguousElementLayoutLit shape3_concrete (bits-of (F32))))

; Rank-3 concrete left-major layout:
;   strides = [1, 30, 600]
;   element index =
;     v2 + v1 * 30 + v0 * 600
;   (all coordinates owned by shape3_concrete)
(let left_strides3_concrete
  (IntExprCons (IntLit 1)
    (IntExprCons (IntLit 30)
      (IntExprCons (IntLit 600)
        (IntExprNil)))))

(let linear3_left_concrete
  (IntAdd
    (CoordVar shape3_concrete 2)
    (IntAdd
      (IntMul (CoordVar shape3_concrete 1) (IntLit 30))
      (IntMul (CoordVar shape3_concrete 0) (IntLit 600)))))

; Rank-3 strided layout with right-major contiguous-equivalent strides:
;   strides = [200, 10, 1]
(let strides3_contiguous
  right_strides3_concrete)

(let layout3_strided_contiguous
  (StridedElementLayoutLit shape3_concrete strides3_contiguous (bits-of (F32))))

; Rank-3 strided layout with non-contiguous element strides:
;   element offset =
;     v2 * 300 + v1 * 20 + v0 * 2
;   (all coordinates owned by shape3_concrete)
(let strides3_noncontiguous
  (IntExprCons (IntLit 300)
    (IntExprCons (IntLit 20)
      (IntExprCons (IntLit 2)
        (IntExprNil)))))

(let layout3_strided_noncontiguous
  (StridedElementLayoutLit shape3_concrete strides3_noncontiguous (bits-of (F32))))

(let linear3_strided_noncontiguous
  (IntAdd
    (IntMul (CoordVar shape3_concrete 2) (IntLit 300))
    (IntAdd
      (IntMul (CoordVar shape3_concrete 1) (IntLit 20))
      (IntMul (CoordVar shape3_concrete 0) (IntLit 2)))))

; Extent-true layout identity: two strided layouts with IDENTICAL strides
; over DIFFERENT shapes. Their folded offset expressions differ in the
; coordinate variables' OWNER shapes, so the layouts must NOT share a
; class — pre-CoordVar they merged (the shape-erasure over-sharing).
(let shape_4x2
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 2) (IntExprNil)))))
(let shape_3x2
  (ShapeLit (IntExprCons (IntLit 3) (IntExprCons (IntLit 2) (IntExprNil)))))
(let strides_2_1
  (IntExprCons (IntLit 2) (IntExprCons (IntLit 1) (IntExprNil))))
(let layout_4x2_strided
  (StridedElementLayoutLit shape_4x2 strides_2_1 (bits-of (F32))))
(let layout_3x2_strided
  (StridedElementLayoutLit shape_3x2 strides_2_1 (bits-of (F32))))

; Downward-discovery scenarios: layouts born as bare expressions, paired
; with tensors, rejoin the constructor ladder on demand.

; A dilated rank-1 layout, expression-only: offset = v0 * 2 over [4].
(let disc_shape (ShapeLit (IntExprCons (IntLit 4) (IntExprNil))))
(let disc_logical (LogicalTensorInputLit (LogicalIdLit "discovery_probe") disc_shape (F32)))
(let disc_elem_layout
  (ElementOffsetExpressionLayoutLit (IntMul (CoordVar disc_shape 0) (IntLit 2)) disc_shape (bits-of (F32))))
(let disc_lt (LayoutTensorLit disc_logical disc_elem_layout))
(element-to-strided-demand disc_lt)

; A contiguous rank-1 layout, expression-only: offset = v0 over [7].
(let disc7_shape (ShapeLit (IntExprCons (IntLit 7) (IntExprNil))))
(let disc7_logical (LogicalTensorInputLit (LogicalIdLit "discovery_probe7") disc7_shape (F32)))
(let disc7_elem_layout
  (ElementOffsetExpressionLayoutLit (CoordVar disc7_shape 0) disc7_shape (bits-of (F32))))
(let disc7_lt (LayoutTensorLit disc7_logical disc7_elem_layout))
(element-to-strided-demand disc7_lt)

; A bit-offset-only layout: v0 * 32 bits over [5] at width 32 (the
; width is the layout's own field; no tensor witness needed since 3c
; became layout-intrinsic).
(let disc5_shape (ShapeLit (IntExprCons (IntLit 5) (IntExprNil))))
(let disc5_logical (LogicalTensorInputLit (LogicalIdLit "discovery_probe5") disc5_shape (F32)))
(let disc5_bit_layout
  (BitOffsetExpressionLayoutLit (IntMul (CoordVar disc5_shape 0) (IntLit 32)) disc5_shape (bits-of (F32))))
(let disc5_lt (LayoutTensorLit disc5_logical disc5_bit_layout))
(bit-to-element-demand disc5_bit_layout)

; A sliced layout: offset = 5 + v0 over [9] — NONZERO remainder, so
; strided discovery must stay silent (offsets punted). The probe's atoms
; (9, 5) are deliberately DISJOINT from the rest of the fixture: an
; additive-constant expression sharing atoms with the multiplicative fold
; soup multiplies the AC/distributivity closure past practical saturation
; (bisected empirically — shape [2] with offset 2 diverged).
(let disc_slice_shape (ShapeLit (IntExprCons (IntLit 9) (IntExprNil))))
(let disc_slice_logical (LogicalTensorInputLit (LogicalIdLit "discovery_probe_slice") disc_slice_shape (F32)))
(let disc_slice_layout
  (ElementOffsetExpressionLayoutLit (IntAdd (IntLit 5) (CoordVar disc_slice_shape 0)) disc_slice_shape (bits-of (F32))))
(let disc_slice_lt (LayoutTensorLit disc_slice_logical disc_slice_layout))
(element-to-strided-demand disc_slice_lt)

; The strided form the slice must NOT discover (constructed up front so the
; distinctness check below has a term to look up).
(let disc_slice_strided_hypothesis
  (StridedElementLayoutLit disc_slice_shape (IntExprCons (IntLit 1) (IntExprNil)) (bits-of (F32))))

; A BROADCAST (zero-stride) strided layout: [4,2] with strides [0,1] — the
; outer axis contributes no offset. Its fold must mint NO IntMul(CoordVar, 0)
; summand (the multiplication-pump seed; see the foldr's zero-stride rule):
; the element expression is just the inner coordinate.
(let bcast_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 2) (IntExprNil)))))
(let bcast_layout
  (StridedElementLayoutLit bcast_shape
    (IntExprCons (IntLit 0) (IntExprCons (IntLit 1) (IntExprNil)))
    (bits-of (F32))))

(run-schedule (saturate (run)) (run materializing-copy-mint) (run layout-tensor-op-metadata) (saturate (run fixpoint-invariants)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; CLI-visible derived tables.

(print-function right-major-strides-state-of)
(print-function left-major-strides-state-of)
(print-function strided-indexing-foldr-state-of)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Checks: these make the file executable as a tiny test script.

; Rank-1 checks.
(check
  (= layout1
     (StridedElementLayoutLit
       shape1
       (IntExprCons (IntLit 1) (IntExprNil))
       (bits-of (Int)))))

(check
  (= layout1
     (ElementOffsetExpressionLayoutLit (CoordVar shape1 0) shape1 (bits-of (Int)))))

(check
  (= layout1
     (BitOffsetExpressionLayoutLit
       (IntMul (CoordVar shape1 0) (IntLit 32))
       shape1
       (bits-of (Int)))))

; Scalar checks.
(check
  (= layout_scalar
     (StridedElementLayoutLit shape_scalar (IntExprNil) (bits-of (F32)))))

(check
  (= layout_scalar
     (ElementOffsetExpressionLayoutLit (IntLit 0) shape_scalar (bits-of (F32)))))

(check
  (= layout_scalar
     (BitOffsetExpressionLayoutLit (IntLit 0) shape_scalar (bits-of (F32)))))

; Rank-3 concrete checks.
(check
  (= (right-major-strides-state-of
       (IntExprCons (IntLit 30)
         (IntExprCons (IntLit 20)
           (IntExprCons (IntLit 10)
             (IntExprNil)))))
     (RightMajorStridesFoldStateLit
       3
       (IntLit 6000)
       right_strides3_concrete)))

(check
  (= layout3_concrete
     (StridedElementLayoutLit shape3_concrete right_strides3_concrete (bits-of (F32)))))

(check
  (= layout3_concrete
     (ElementOffsetExpressionLayoutLit linear3_concrete shape3_concrete (bits-of (F32)))))

(check
  (= layout3_concrete
     (BitOffsetExpressionLayoutLit
       (IntMul linear3_concrete (IntLit 32))
       shape3_concrete
       (bits-of (F32)))))

; Rank-3 concrete left-major checks.
(check
  (= (left-major-strides-state-of
       (IntExprCons (IntLit 30)
         (IntExprCons (IntLit 20)
           (IntExprCons (IntLit 10)
             (IntExprNil)))))
     (LeftMajorStridesFoldStateLit
       3
       (IntLit 6000)
       left_strides3_concrete)))

(check
  (= layout3_left_concrete
     (StridedElementLayoutLit shape3_concrete left_strides3_concrete (bits-of (F32)))))

(check
  (= layout3_left_concrete
     (ElementOffsetExpressionLayoutLit linear3_left_concrete shape3_concrete (bits-of (F32)))))

(check
  (= layout3_left_concrete
     (BitOffsetExpressionLayoutLit
       (IntMul linear3_left_concrete (IntLit 32))
       shape3_concrete
       (bits-of (F32)))))

; Rank-3 strided checks.
(check
  (= layout3_strided_contiguous
     (ElementOffsetExpressionLayoutLit linear3_concrete shape3_concrete (bits-of (F32)))))

(check
  (= layout3_strided_contiguous
     (BitOffsetExpressionLayoutLit
       (IntMul linear3_concrete (IntLit 32))
       shape3_concrete
       (bits-of (F32)))))

(check
  (= layout3_strided_noncontiguous
     (ElementOffsetExpressionLayoutLit linear3_strided_noncontiguous shape3_concrete (bits-of (F32)))))

(check
  (= layout3_strided_noncontiguous
     (BitOffsetExpressionLayoutLit
       (IntMul linear3_strided_noncontiguous (IntLit 32))
       shape3_concrete
       (bits-of (F32)))))

; Extent-true identity checks: each strided layout folds to the offset
; expression over ITS OWN extents...
(check
  (= layout_4x2_strided
     (ElementOffsetExpressionLayoutLit
       (IntAdd (IntMul (CoordVar shape_4x2 1) (IntLit 2)) (CoordVar shape_4x2 0))
       shape_4x2
       (bits-of (F32)))))

(check
  (= layout_3x2_strided
     (ElementOffsetExpressionLayoutLit
       (IntAdd (IntMul (CoordVar shape_3x2 1) (IntLit 2)) (CoordVar shape_3x2 0))
       shape_3x2
       (bits-of (F32)))))

; ...and same strides over different shapes do NOT share a layout class.
(check (!= layout_4x2_strided layout_3x2_strided))

; Downward-discovery checks. The dilated expression-only layout discovers
; its strided form...
(check
  (= disc_elem_layout
     (StridedElementLayoutLit disc_shape (IntExprCons (IntLit 2) (IntExprNil)) (bits-of (F32)))))

; ...the contiguous-equivalent one discovers strided and (rank-1:
; right == left major) both contiguous constructors...
(check
  (= disc7_elem_layout
     (StridedElementLayoutLit disc7_shape (IntExprCons (IntLit 1) (IntExprNil)) (bits-of (F32)))))
(check
  (= disc7_elem_layout
     (RightMajorContiguousElementLayoutLit disc7_shape (bits-of (F32)))))
(check
  (= disc7_elem_layout
     (LeftMajorContiguousElementLayoutLit disc7_shape (bits-of (F32)))))

; ...the bit-only layout recovers its element form at its tensor's width...
(check
  (= disc5_bit_layout
     (ElementOffsetExpressionLayoutLit (CoordVar disc5_shape 0) disc5_shape (bits-of (F32)))))

; ...and the sliced layout (nonzero constant remainder) discovers NO
; strided form: offsets are punted, so discovery must stay silent.
(check (!= disc_slice_layout disc_slice_strided_hypothesis))

; Broadcast fold: the zero-stride axis vanishes from the element offset —
; the fold expression IS the inner coordinate, with no zero summand.
(check
  (= bcast_layout
     (ElementOffsetExpressionLayoutLit (CoordVar bcast_shape 0) bcast_shape (bits-of (F32)))))
(check
  (= bcast_layout
     (BitOffsetExpressionLayoutLit (IntMul (CoordVar bcast_shape 0) (IntLit 32)) bcast_shape (bits-of (F32)))))
