;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Adversarial substitution pins (subst-of): the cases most likely to
; expose an unsound or non-simultaneous substitution. Every expected
; result is hand-computed. Conventions under test:
;   - entries: first list element <-> HIGHEST input axis; nth-from-end
;     is ZERO-based (luminal-aligned, ruling 2026-07-24): axis k reads
;     entry k directly
;   - simultaneity: all variables substituted against the ORIGINAL map,
;     never against already-substituted results
;   - union-merge: images of different representatives of one class are
;     unioned (sound by the function-identity contract, under the
;     CoordVar arm's in-range instantiation guard)
;   - identification (ruling 2026-07-29): a substitution is
;     (expr, map, SOURCE SHAPE) — the shape names σ's domain (WHICH
;     (axis, extent) variables are rewritten) and joins the subst-of
;     key; the CoordVar arm carries domain membership (signature) and
;     instantiation legality (range) as separate premise groups

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P1 — SQUARE transpose: the formal-collision case. Input and output
; formals are the SAME terms (both axes span 3), so any sequential
; scheme corrupts (v0 -> v1 -> v0 again); only simultaneous survives.
(let p1_source_shape
  (ShapeLit (IntExprCons (IntLit 3) (IntExprCons (IntLit 3) (IntExprNil)))))
(let p1_parent
  (IntAdd (IntMul (CoordVar 1 (IntLit 3)) (IntLit 3)) (CoordVar 0 (IntLit 3))))
(let p1_map
  (IndexMapLit
    (IntExprCons (CoordVar 0 (IntLit 3))
      (IntExprCons (CoordVar 1 (IntLit 3))
        (IntExprNil)))))
(subst-demand p1_parent p1_map p1_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P2 — rank-3 FULL PERMUTATION (a 3-cycle), all sizes distinct so any
; axis/size mix-up changes the answer. Also exercises the middle index
; of a 3-entry list (the nth-from-end upward-propagation fix).
; Parent [2,3,5], right-major: offset = 15*v2 + 5*v1 + v0.
; Map: dim0(5)<-v1, dim1(3)<-v2, dim2(2)<-v0; output shape [3,5,2].
(let p2_source_shape
  (ShapeLit
    (IntExprCons (IntLit 2)
      (IntExprCons (IntLit 3) (IntExprCons (IntLit 5) (IntExprNil))))))
(let p2_parent
  (IntAdd (IntMul (CoordVar 2 (IntLit 2)) (IntLit 15))
    (IntAdd (IntMul (CoordVar 1 (IntLit 3)) (IntLit 5))
      (CoordVar 0 (IntLit 5)))))
(let p2_map
  (IndexMapLit
    (IntExprCons (CoordVar 0 (IntLit 2))
      (IntExprCons (CoordVar 2 (IntLit 3))
        (IntExprCons (CoordVar 1 (IntLit 5))
          (IntExprNil))))))
(subst-demand p2_parent p2_map p2_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P3 — DIAGONAL: one output variable feeds BOTH input axes (repeated
; entries). Parent [4,4]: offset = 4*v1 + v0; both dims <- v0(4).
(let p3_source_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 4) (IntExprNil)))))
(let p3_parent
  (IntAdd (IntMul (CoordVar 1 (IntLit 4)) (IntLit 4)) (CoordVar 0 (IntLit 4))))
(let p3_map
  (IndexMapLit
    (IntExprCons (CoordVar 0 (IntLit 4))
      (IntExprCons (CoordVar 0 (IntLit 4))
        (IntExprNil)))))
(subst-demand p3_parent p3_map p3_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P4 — COMPOUND entries + cross-axis mapping: dim0(8) <- 2*v1 + 1 (a
; strided, shifted window), dim1(4) <- v0(2). Parent [4,8]: 8*v1 + v0.
; Output [3,2].
(let p4_source_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 8) (IntExprNil)))))
(let p4_parent
  (IntAdd (IntMul (CoordVar 1 (IntLit 4)) (IntLit 8)) (CoordVar 0 (IntLit 8))))
(let p4_map
  (IndexMapLit
    (IntExprCons (CoordVar 0 (IntLit 2))
      (IntExprCons (IntAdd (IntMul (CoordVar 1 (IntLit 3)) (IntLit 2)) (IntLit 1))
        (IntExprNil)))))
(subst-demand p4_parent p4_map p4_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P5 — MULTI-REPRESENTATIVE agreement: the parent class is given TWO
; syntactically different, function-equal representatives (a script
; union — a distributivity instance the rule set no longer derives).
; Substitution images of BOTH representatives must land in ONE class:
; the union-merge soundness of subst-of, exercised deliberately.
; Parent reps: (v1 + v0) * 2  ==  v1*2 + v0*2, both over [6,6].
; Map: dim1 <- 2 (a slice), dim0 <- v0(6); output [6].
(let p5_source_shape
  (ShapeLit (IntExprCons (IntLit 6) (IntExprCons (IntLit 6) (IntExprNil)))))
(let p5_parent (IntMul (IntAdd (CoordVar 1 (IntLit 6)) (CoordVar 0 (IntLit 6))) (IntLit 2)))
(let p5_parent_alt
  (IntAdd (IntMul (CoordVar 1 (IntLit 6)) (IntLit 2)) (IntMul (CoordVar 0 (IntLit 6)) (IntLit 2))))
(union p5_parent p5_parent_alt)
(let p5_map
  (IndexMapLit
    (IntExprCons (IntLit 2)
      (IntExprCons (CoordVar 0 (IntLit 6))
        (IntExprNil)))))
(subst-demand p5_parent p5_map p5_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P6 — IDENTITY / BROADCAST rank-up: rank-1 parent viewed inside [4,5]
; by its own coordinate. The composed expression IS the parent's — the
; expression level is CORRECT here; the domain distinction is the
; LAYOUT's job (the broadcast-domain question, tracked separately).
(let p6_source_shape (ShapeLit (IntExprCons (IntLit 5) (IntExprNil))))
(let p6_parent (CoordVar 0 (IntLit 5)))
(let p6_map
  (IndexMapLit
    (IntExprCons (CoordVar 0 (IntLit 5))
      (IntExprNil))))
(subst-demand p6_parent p6_map p6_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P7 — OUT-OF-RANGE axis: the parent mentions v2 but the map has two
; entries (and the source shape has rank 2), so the root substitution
; must never complete (silent incompleteness, never a panic or a
; partial result). Unsetness of the root is pinned by fail-check; the
; in-range subterm's image is checked positively.
(let p7_source_shape
  (ShapeLit (IntExprCons (IntLit 7) (IntExprCons (IntLit 5) (IntExprNil)))))
(let p7_parent (IntAdd (CoordVar 2 (IntLit 7)) (CoordVar 0 (IntLit 5))))
(let p7_map
  (IndexMapLit
    (IntExprCons (IntLit 0)
      (IntExprCons (CoordVar 0 (IntLit 5))
        (IntExprNil)))))
(subst-demand p7_parent p7_map p7_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P8 — DOMAIN TARGETING (ruling 2026-07-29): a FOREIGN coordinate —
; same axis, different extent, so a different box's variable — is NOT
; in σ's domain and must be left fixed even though its entry is
; in-range for the foreign box (entry 1 fits in [0,4]); only the
; signature premise can be the blocker here, which is exactly what this
; pins. The source box's own coordinate substitutes normally.
(let p8_source_shape (ShapeLit (IntExprCons (IntLit 3) (IntExprNil))))
(let p8_map (IndexMapLit (IntExprCons (IntLit 1) (IntExprNil))))
(let p8_own (CoordVar 0 (IntLit 3)))
(let p8_foreign (CoordVar 0 (IntLit 5)))
(subst-demand p8_own p8_map p8_source_shape)
(subst-demand p8_foreign p8_map p8_source_shape)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P9 — BOOL BRIDGE traversal (ruling 2026-07-29): substitution crosses
; IntCastFromBool through the bool-level mirror (bool-subst-of),
; re-entering the integer machinery at the comparison's children.
; Parent: cast(v0 < 2) over [3]; map: the reversal v0 <- 2 - v0.
; Image: cast((2 - v0) < 2) — undecided over the box (true at v0=1,2;
; false at v0=0), so it stays a bit; the pin is the structural image.
(let p9_source_shape (ShapeLit (IntExprCons (IntLit 3) (IntExprNil))))
(let p9_entry (IntAdd (IntLit 2) (IntMul (IntLit -1) (CoordVar 0 (IntLit 3)))))
(let p9_map (IndexMapLit (IntExprCons p9_entry (IntExprNil))))
(let p9_parent (IntCastFromBool (BoolLessThanInt (CoordVar 0 (IntLit 3)) (IntLit 2))))
(subst-demand p9_parent p9_map p9_source_shape)

(run-schedule (saturate (run)) (saturate (run fixpoint-invariants)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P1: swap lands both variables at once: 3*v0 + v1.
(check
  (= (subst-of p1_parent p1_map p1_source_shape)
     (IntAdd (IntMul (CoordVar 0 (IntLit 3)) (IntLit 3)) (CoordVar 1 (IntLit 3)))))

; P2: the 3-cycle: 15*v0(2) + 5*v2(3) + v1(5).
(check
  (= (subst-of p2_parent p2_map p2_source_shape)
     (IntAdd (IntMul (CoordVar 0 (IntLit 2)) (IntLit 15))
       (IntAdd (IntMul (CoordVar 2 (IntLit 3)) (IntLit 5))
         (CoordVar 1 (IntLit 5))))))

; P3: the diagonal: 4*v0 + v0, exactly this form (no ring folding —
; distributivity is deliberately absent).
(check
  (= (subst-of p3_parent p3_map p3_source_shape)
     (IntAdd (IntMul (CoordVar 0 (IntLit 4)) (IntLit 4)) (CoordVar 0 (IntLit 4)))))

; P4: compound entry lands intact: 8*v0(2) + (2*v1(3) + 1).
(check
  (= (subst-of p4_parent p4_map p4_source_shape)
     (IntAdd (IntMul (CoordVar 0 (IntLit 2)) (IntLit 8))
       (IntAdd (IntMul (CoordVar 1 (IntLit 3)) (IntLit 2)) (IntLit 1)))))

; P5: BOTH representatives' images are in the one result class — the
; factored image verbatim, and the expanded image with its constant
; folded (2*2 -> 4).
(check
  (= (subst-of p5_parent p5_map p5_source_shape)
     (IntMul (IntAdd (IntLit 2) (CoordVar 0 (IntLit 6))) (IntLit 2))))
(check
  (= (subst-of p5_parent p5_map p5_source_shape)
     (IntAdd (IntLit 4) (IntMul (CoordVar 0 (IntLit 6)) (IntLit 2)))))

; P6: identity composition: the image IS the parent expression.
(check (= (subst-of p6_parent p6_map p6_source_shape) p6_parent))

; P7: the in-range subterm resolves...
(check (= (subst-of (CoordVar 0 (IntLit 5)) p7_map p7_source_shape) (CoordVar 0 (IntLit 5))))
; ...and the root never completes: axis 2 has no map entry and no
; source dim, which downstream consumers see as "composition not
; derivable" — the fail-safe.
(fail (check (= ?p7_image (subst-of p7_parent p7_map p7_source_shape))))

; P8: the source box's own coordinate substitutes; the foreign
; coordinate's slot never fills — domain membership, not range, is the
; refusal (the entry is in-range for both boxes).
(check (= (subst-of p8_own p8_map p8_source_shape) (IntLit 1)))
(fail (check (= ?p8_image (subst-of p8_foreign p8_map p8_source_shape))))

; P9: the cast crosses: image = cast((2 - v0) < 2), structurally.
(check
  (= (subst-of p9_parent p9_map p9_source_shape)
     (IntCastFromBool (BoolLessThanInt p9_entry (IntLit 2)))))
