; Standalone playground:
;   RightMajorContiguousElementLayoutLit -> ElementOffsetExpressionLayoutLit -> BitOffsetExpressionLayoutLit
;
; Shape lists are stored outer-to-inner.
; Example rank-3 shape:
;   (size_2 size_1 size_0)
;
; The suffix fold visits the inner dimension first by waiting for the tail's
; offset-state before constructing the current list's offset-state.

(datatype*
  (Expr
    (Num i64)
    (Var String)
    (Add Expr Expr)
    (Mul Expr Expr))

  (ExprList
    (ExprCons Expr ExprList)
    (ExprNil))

  (Shape
    (ShapeLit ExprList))

  (Dtype
    (F32)
    (Int))

  (ElementIndexExpression
    (ElementIndexExpressionLit Expr))

  (Layout
    (RightMajorContiguousElementLayoutLit Shape Dtype)
    (ElementOffsetExpressionLayoutLit ElementIndexExpression Dtype)
    (BitOffsetExpressionLayoutLit Expr))

  ; next-axis, stride-so-far, linear-element-index-so-far
  (OffsetState
    (OffsetStateLit i64 Expr Expr)))

(ruleset layout-analysis)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Dtype bit widths.

(function bits-of (Dtype) i64 :no-merge)
(set (bits-of (F32)) 32)
(set (bits-of (Int)) 32)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Small Expr simplifier, just enough to make the derived examples readable.

(rewrite (Add ?expr (Num 0)) ?expr :ruleset layout-analysis)
(rewrite (Mul ?expr (Num 1)) ?expr :ruleset layout-analysis)
(rewrite (Mul (Num 1) ?expr) ?expr :ruleset layout-analysis)
(rewrite (Add (Num ?lhs_value) (Num ?rhs_value)) (Num (+ ?lhs_value ?rhs_value)) :ruleset layout-analysis)
(rewrite (Mul (Num ?lhs_value) (Num ?rhs_value)) (Num (* ?lhs_value ?rhs_value)) :ruleset layout-analysis)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Suffix fold.

(relation offset-state-demand (ExprList))
(function offset-state-of (ExprList) OffsetState :no-merge)

; Inspection helpers. These are not strictly necessary for equality saturation,
; but they make the derived result easy to print and check.
(function element-index-expr-of (Layout) ElementIndexExpression :no-merge)
(function bit-offset-expr-of (Layout) Expr :no-merge)

; Ask for the fold state of any shape used by a contiguous layout.
(rule
  (
    (= ?layout (RightMajorContiguousElementLayoutLit (ShapeLit ?dims) ?dtype))
  )
  (
    (offset-state-demand ?dims)
  )
  :ruleset layout-analysis)

; Demand all suffixes of a demanded list.
(rule
  (
    (offset-state-demand (ExprCons ?size ?tail))
  )
  (
    (offset-state-demand ?tail)
  )
  :ruleset layout-analysis)

; Empty suffix:
;   next-axis = 0
;   stride    = 1
;   linear    = 0
(rule
  (
    (offset-state-demand (ExprNil))
  )
  (
    (set (offset-state-of (ExprNil))
         (OffsetStateLit 0 (Num 1) (Num 0)))
  )
  :ruleset layout-analysis)

; Non-empty suffix:
;   if tail has axis=i, stride=s, linear=e
;   then current list has:
;     axis   = i + 1
;     stride = current-size * s
;     linear = var_i_index * s + e
(rule
  (
    (offset-state-demand ?list)
    (= ?list (ExprCons ?size ?tail))
    (= (offset-state-of ?tail)
       (OffsetStateLit ?axis ?stride ?linear))
  )
  (
    (set (offset-state-of ?list)
         (OffsetStateLit
           (+ ?axis 1)
           (Mul ?size ?stride)
           (Add
             (Mul
               (Var (+ (+ "var_" (to-string ?axis)) "_index"))
               ?stride)
             ?linear)))
  )
  :ruleset layout-analysis)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Stage 1:
;   RightMajorContiguousElementLayoutLit(shape, dtype)
;     ==
;   ElementOffsetExpressionLayoutLit(linear-element-index(shape), dtype)

(rule
  (
    (= ?layout (RightMajorContiguousElementLayoutLit (ShapeLit ?dims) ?dtype))
    (= (offset-state-of ?dims)
       (OffsetStateLit ?rank ?total-elements ?linear))
  )
  (
    (set (element-index-expr-of ?layout)
         (ElementIndexExpressionLit ?linear))
    (union ?layout
           (ElementOffsetExpressionLayoutLit
             (ElementIndexExpressionLit ?linear)
             ?dtype))
  )
  :ruleset layout-analysis)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Stage 2:
;   ElementOffsetExpressionLayoutLit(linear-element-index, dtype)
;     ==
;   BitOffsetExpressionLayoutLit(linear-element-index * bits-of(dtype))

(rule
  (
    (= ?layout
       (ElementOffsetExpressionLayoutLit (ElementIndexExpressionLit ?linear) ?dtype))
    (= ?bits (bits-of ?dtype))
  )
  (
    (set (bit-offset-expr-of ?layout)
         (Mul ?linear (Num ?bits)))
    (union ?layout
           (BitOffsetExpressionLayoutLit
             (Mul ?linear (Num ?bits))))
  )
  :ruleset layout-analysis)
