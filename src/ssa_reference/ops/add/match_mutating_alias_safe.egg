; Layout Tensor Op Add Mutating Input-Alias-Safe (mutates operand 1; BOTH
; inputs and the output share ?layout, so operand 2 may alias the mutated
; storage — the permit's precondition is discharged HERE, at match time,
; never checked by the bufferization engine)
(rule
  (
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?layout))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?layout))
    (= ?out_logical (LogicalAdd ?in1_logical ?in2_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor
          (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpAddMutatingInputAliasSafeGeneric ?in1_layout_tensor ?in2_layout_tensor))
  )
)
