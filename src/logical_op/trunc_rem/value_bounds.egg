; Value bounds : LogicalTruncRem — |rem| <= max|divisor| - 1 over a
; zero-free divisor range (symmetric; sign refinement can come later).
(rule
  (
    (= ?out (LogicalTruncRem ?lhs ?rhs))
    (= ?rhs_lower (value-lower-bound-of ?rhs))
    (= ?rhs_upper (value-upper-bound-of ?rhs))
    (>= ?rhs_lower (bigint 1))
  )
  (
    (set (value-lower-bound-of ?out)
      (- (bigint 1) (max ?rhs_upper (- (bigint 0) ?rhs_lower))))
    (set (value-upper-bound-of ?out)
      (- (max ?rhs_upper (- (bigint 0) ?rhs_lower)) (bigint 1)))
  )
)
(rule
  (
    (= ?out (LogicalTruncRem ?lhs ?rhs))
    (= ?rhs_lower (value-lower-bound-of ?rhs))
    (= ?rhs_upper (value-upper-bound-of ?rhs))
    (<= ?rhs_upper (bigint -1))
  )
  (
    (set (value-lower-bound-of ?out)
      (- (bigint 1) (max ?rhs_upper (- (bigint 0) ?rhs_lower))))
    (set (value-upper-bound-of ?out)
      (- (max ?rhs_upper (- (bigint 0) ?rhs_lower)) (bigint 1)))
  )
)
